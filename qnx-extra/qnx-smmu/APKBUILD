# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname="qnx-smmu"
pkgver=8.0.5
_smmu_ver=0.0.2.02005T202411230033L
pkgrel=0
pkgdesc="System Memory Management Unit Manager (SMMUMAN)"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
options="!strip !tracedeps !check !useinfo"
depends="qnx-libslog2 qnx-secpol"
subpackages="$pkgname-dev $pkgname-dbg $pkgname-static"
source="
    smmu_api_$_smmu_ver.qpkg::$QSC_URL/com.qnx.qnx800.target.os_services.smmu.api/$_smmu_ver/download
    smmu_core_$_smmu_ver.qpkg::$QSC_URL/com.qnx.qnx800.target.os_services.smmu.core/$_smmu_ver/download
"
builddir="$srcdir"

prepare() {
    for qpkg in *.qpkg; do
        tar xf $qpkg
    done
}

package() {
    mkdir -p "$pkgdir"

    _qarch=$CARCH
    if [[ $CARCH == "aarch64" ]]; then
        _qarch=aarch64le
    fi
    
    echo "Moving arch-specific ($_qarch) files"
    cp -r "$srcdir"/target/qnx/$_qarch/* "$pkgdir"/


    echo "Relocating bin and lib for a merged /usr"
    mkdir -p "$pkgdir"/usr/lib/
    mv "$pkgdir"/lib/* "$pkgdir"/usr/lib/
    rmdir "$pkgdir"/lib

    mkdir -p "$pkgdir"/usr/bin/
    mv "$pkgdir"/sbin/* "$pkgdir"/usr/bin/
    rmdir "$pkgdir"/sbin

    cp -r "$srcdir"/target/qnx/usr/include "$pkgdir/usr/include"
}

dev() {
    amove usr/include
}

dbg() {
    amove usr/bin/*.sym
    amove usr/lib/dll/*.sym
}

sha512sums="
