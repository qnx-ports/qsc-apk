# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname="qnx-wpa_supplicant"
pkgver=8.0.5
_wpa_supplicant_version=0.0.6.00014T202605060705L
pkgrel=1
pkgdesc="QNX Random Service"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
options="!strip !tracedeps !check"
depends="qnx-crypto qnx-secpol qnx-libqh qnx-libslog2"
subpackages="$pkgname-dbg $pkgname-dev"
source="wpa_supplicant_2.11.iosock_$_wpa_supplicant_version.qpkg::$QSC_URL/com.qnx.qnx800.target.net.wpa_supplicant_2.11.iosock/$_wpa_supplicant_version/download
    wpa_supplicant.initd
    example.conf
    example.conf.verbose
"
builddir="$srcdir"

prepare() {
   for qpkg in *.qpkg; do
        tar xf $qpkg
   done
}

# extglob for trimming out other arch's toolchain
shopt -s extglob
package() {
    mkdir -p "$pkgdir"
    echo "Moving common headers"
    mv "$srcdir"/target/qnx/usr "$pkgdir"
    echo $CARCH
    _qarch=$CARCH
    if [[ $CARCH == "aarch64" ]]; then
        export _qarch=aarch64le
    fi

    install -p 755 -d $pkgdir/usr/bin
    install -p 755 -d $pkgdir/usr/lib

    echo "Moving arch-specific ($_qarch) binaries"
    cp -r "$srcdir"/target/qnx/$_qarch/usr/sbin/* "$pkgdir"/usr/bin

    echo "Moving arch-specific ($_qarch) libraries"
    cp -r "$srcdir"/target/qnx/$_qarch/usr/lib/* "$pkgdir"/usr/lib/

    install -D -m 0644 "$srcdir/example.conf" "$pkgdir/etc/wpa_supplicant/example.conf"
    install -D -m 0644 "$srcdir/example.conf.verbose" "$pkgdir/etc/wpa_supplicant/example.conf.verbose"
}

dbg() {
    amove usr/bin/*.sym
    amove usr/lib/*.sym
}



