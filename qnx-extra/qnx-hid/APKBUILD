1e29ec61d17bd946a95162a37d1015dd0c80f80f1f849be9802689830cfba52e73f5b7c02590788068d53d48159914d745998cc4df295498bfcd0085f6f8c20c  io-hid.initd
b5c41442ccf45f2ee6def9a09d753a4ff1620bd8e312d324bee4f6f09ea492249717fc47a950f6f4bc84bab0c72471caa47b78ca3cc8744fd763d71e825e3b57  io-hid.confd
