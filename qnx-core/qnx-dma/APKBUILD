# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname="qnx-dma"
pkgver=8.0.5
_dma_version="0.0.1.00443T202311201012L"
pkgrel=0
pkgdesc="QNX DMA library"
url="https://qnx.com"
arch="noarch"
license="LicenseRef-QDL-Non-Commercial"
options="!strip !tracedeps !check"
depends=""
source="dma_$_dma_version.qpkg::$QSC_URL/com.qnx.qnx800.target.drivers.dma/$_dma_version/download"
builddir="$srcdir"

prepare() {
   for qpkg in *.qpkg; do
        tar xf $qpkg
   done
}

# extglob for trimming out other arch's toolchain
shopt -s extglob
package() {
    mkdir -p "$pkgdir"
    echo "Moving common headers"
    mv "$srcdir"/target/qnx/usr "$pkgdir"
}

sha512sums="
