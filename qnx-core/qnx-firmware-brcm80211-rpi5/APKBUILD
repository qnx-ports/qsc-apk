# Maintainer: Aaron Bassett <abaseett@qnx.com>
pkgname="qnx-firmware-brcm80211-rpi5"
pkgver=8.0.5
_cypress_dhd_sdio_ver="0.0.4.00003T202510060827L"
_firmware_nonfree_ver="1%2520240709-2_bpo12+1+rpt4"
pkgrel=1
pkgdesc="Wifi firmware for RPi 5 brcm80211"
url="https://qnx.com"
arch="aarch64"
#TODO: populate the propper license for brcmfmac43455-sdio.bin
license="LicenseRef-QDL-Non-Commercial"
options="!strip !tracedeps"
subpackages=""
#com.qnx.qnx800.target.driver.cypress_dhd_sdio-$_cypress_dhd_sdio_ver.qpkg::$QSC_URL/com.qnx.qnx800dev.target.driver.cypress_dhd_sdio/$_cypress_dhd_sdio_ver/download
source="
      com.qnx.qnx800.target.driver.cypress_dhd_sdio-$_cypress_dhd_sdio_ver.qpkg::$QSC_URL/com.qnx.qnx800.target.driver.cypress_dhd_sdio/$_cypress_dhd_sdio_ver/download
      https://github.com/RPi-Distro/firmware-nonfree/archive/refs/tags/pios/$_firmware_nonfree_ver.tar.gz
"
builddir="$srcdir"

prepare() {
    for qpkg in *.qpkg; do
        tar xf $qpkg
    done


    # Not sure if i should just take everything from com.qnx.qnx800.target.driver.cypress_dhd_sdio vs RPi-Distro/firmware-nonfree
    # but this configureation matches with the current qsti
    tar -xf $_firmware_nonfree_ver.tar.gz --strip-components=4 --wildcards */debian/config/brcm80211/*
}

package() {
    mkdir -p "$pkgdir"

    _qarch=$CARCH
    if [[ $CARCH == "aarch64" ]]; then
        _qarch=aarch64le
    fi

    install -m 0755 -d "$pkgdir"/usr/lib/firmware/brcm

    echo "Moving firmware files"
    # We must use brcmfmac43455-sdio.raspberrypi,5-model-b.bin from om.qnx.qnx800.target.driver.cypress_dhd_sdio the RPi-Distro/firmware-nonfree does not work for us
    cp target/qnx/etc/firmware/bcm43455_firmware_pkg/brcmfmac43455-sdio.bin "$pkgdir"/usr/lib/firmware/brcm/brcmfmac43455-sdio.raspberrypi,5-model-b.bin

    cp -L "$srcdir"/brcm/brcmfmac43455-sdio.raspberrypi,5-model-b.txt "$pkgdir"/usr/lib/firmware/brcm
    cp -L "$srcdir"/brcm/brcmfmac43455-sdio.raspberrypi,5-model-b.clm_blob "$pkgdir"/usr/lib/firmware/brcm
}

sha512sums="
