pkgname="qnx-slogger2"
pkgver=8.0.6
_slogger2_version=0.6.0.06031T202610011839L
pkgrel=0
pkgdesc="QNX System Logger 2"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
options="!strip !tracedeps"
depends="qnx-gcc-libs qnx-secpol qnx-libslog2"
subpackages="$pkgname-dev"
source="slogger2_$_slogger2_version.qpkg::$QSC_URL/com.qnx.qnx800.target.microkernel.slogger2/$_slogger2_version/download
"
builddir="$srcdir"

prepare() {
   for qpkg in *.qpkg; do
        tar xf $qpkg
   done
}

# extglob for trimming out other arch's toolchain
shopt -s extglob
package() {
    mkdir -p "$pkgdir"
    echo "Moving common headers"
    mv "$srcdir"/target/qnx/usr "$pkgdir"
    echo $CARCH
    _qarch=$CARCH
    if [[ $CARCH == "aarch64" ]]; then
        export _qarch=aarch64le
    fi
    mkdir -p "$pkgdir"/usr/{bin,lib}
    echo "Moving arch-specfic ($_qarch) binaries"
    cp -r "$srcdir"/target/qnx/$_qarch/bin/* "$pkgdir"/usr/bin/
    echo "Moving arch-specific ($_qarch) libraries"
    cp -r "$srcdir"/target/qnx/$_qarch/lib/* "$pkgdir"/usr/lib/
}

dev() {
    default_dev

    amove usr/lib/*.sym
}

sha512sums="
4923cfc09786e2d9f932e8557ed6ad46e6ee6b4805af967490bc83950c7cdef1476793f35ca6b7d954aea2c6af5900cded4806f26ecf40514c2314e57b40a4f6  slogger2_0.6.0.06031T202610011839L.qpkg
"
