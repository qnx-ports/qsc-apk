pkgname="qnx-tools"
pkgver=8.0.6
_tools_version=0.2.0.06031T202610011839L
pkgrel=0
pkgdesc="QNX System Tools"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
options="!strip !tracedeps"
depends="qnx-gcc-libs qnx-secpol qnx-libslog2 qnx-zlib"
subpackages="$pkgname-dbg $pkgname-dev"
source="tools_$_tools_version.qpkg::$QSC_URL/com.qnx.qnx800.target.microkernel.tools/$_tools_version/download
"
builddir="$srcdir"

prepare() {
   for qpkg in *.qpkg; do
        tar xf $qpkg
   done
}

# extglob for trimming out other arch's toolchain
shopt -s extglob
package() {
    mkdir -p "$pkgdir"
    echo "Moving common headers"
    mv "$srcdir"/target/qnx/usr "$pkgdir"
    echo $CARCH
    _qarch=$CARCH
    if [[ $CARCH == "aarch64" ]]; then
        export _qarch=aarch64le
    fi
    mkdir -p "$pkgdir"/usr/{bin,lib}
    echo "Moving arch-specfic ($_qarch) binaries"
    cp -r "$srcdir"/target/qnx/$_qarch/usr/sbin/* "$pkgdir"/usr/bin/
    cp -r "$srcdir"/target/qnx/$_qarch/usr/bin/* "$pkgdir"/usr/bin/
    echo "Moving arch-specific ($_qarch) libraries"
    cp -r "$srcdir"/target/qnx/$_qarch/lib/* "$pkgdir"/usr/lib/
    cp -r "$srcdir"/target/qnx/$_qarch/usr/lib/* "$pkgdir"/usr/lib/
}

dbg() {
    amove usr/lib/*.sym
    amove usr/bin/*.sym
}

sha512sums="
27245b539237fd9ba4c5f62d672be61e67ac8ace060b592446cd98d1226a2841053ecfc46668f2dd82be596f87623a60345216c22322d7eaf02d1de013a1f70c  tools_0.2.0.06031T202610011839L.qpkg
"
